# ==============================================================================
# .gitignore
# ------------------------------------------------------------------------------
# Order matters: within this file, the LAST matching pattern wins, and a "!"
# rule cannot re-include a file whose parent directory is excluded.
# Keep the "Exceptions" section at the very bottom.
# ==============================================================================


# ==============================================================================
# 1. JavaScript / TypeScript
# ==============================================================================

# ---- Dependencies & package managers -----------------------------------------
node_modules
*.pnp
*.pnp.js
*.yarn/install-state.gz
.pnpm-store

# ---- Build output -------------------------------------------------------------
dist
dist-ssr
build
*.local

# ---- Next.js ------------------------------------------------------------------
.next/
out/
next-env.d.ts
.vercel

# ---- Vite ---------------------------------------------------------------------
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ---- TypeScript ---------------------------------------------------------------
*.tsbuildinfo

# ---- Package tarballs (output of `pnpm pack` / `npm pack`) -------------------
*.tgz

# ---- Test coverage (Jest / Vitest / nyc) --------------------------------------
coverage
*.lcov
.nyc_output

# ---- Caches -------------------------------------------------------------------
.eslintcache
.stylelintcache
.parcel-cache
.npm

# ---- Node runtime data --------------------------------------------------------
# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock
.node_repl_history


# ==============================================================================
# 2. Logs
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ==============================================================================
# 3. Environment files & secrets
# ==============================================================================

# ---- Local env files ----------------------------------------------------------
.env
.env.local
.env*.local
*.env*
*.local

# ---- Certificates (e.g. local SSL certs) --------------------------------------
*.pem


# ==============================================================================
# 4. Editor / IDE
# ==============================================================================

# ---- VS Code ------------------------------------------------------------------
.vscode/*
.vscode*
# `.vscode*` also excludes the .vscode/ folder itself, which would block the
# extensions.json exception below. Re-include the folder; its contents stay
# ignored by `.vscode/*`.
!.vscode/
!.vscode/extensions.json

# ---- JetBrains / Visual Studio / Vim ------------------------------------------
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Cursor -------------------------------------------------------------------
.cursorignore
.cursorindexingignore


# ==============================================================================
# 5. OS files
# ==============================================================================
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/


# ==============================================================================
# 6. Project-specific
# ==============================================================================
*API_Test
output
output/*
**/output
test*.py

# Translations: `i18nexus pull` downloads them (dev/build/start run it first);
# upload edits with `npm run i18n:push`. `ui` is the exception: it is committed,
# because adding it to i18nexus would exceed the plan's string limit.
# (Files, not the folder, are ignored, so the "!" rule below can re-include ui.json.)
/locales/**/*.json
!/locales/*/ui.json


# ==============================================================================
# 7. Python
# ==============================================================================

# ---- Byte-compiled / cache ----------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so

# ---- Distribution / packaging -------------------------------------------------
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- PyInstaller --------------------------------------------------------------
*.manifest
*.spec

# ---- Installer logs -----------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt

# ---- Unit test / coverage reports ---------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# ---- Translations -------------------------------------------------------------
*.mo
*.pot

# ---- Django -------------------------------------------------------------------
local_settings.py
db.sqlite3
db.sqlite3-journal

# ---- Flask --------------------------------------------------------------------
instance/
.webassets-cache

# ---- Scrapy -------------------------------------------------------------------
.scrapy

# ---- Sphinx docs --------------------------------------------------------------
docs/_build/

# ---- PyBuilder ----------------------------------------------------------------
.pybuilder/
target/

# ---- Jupyter / IPython --------------------------------------------------------
.ipynb_checkpoints
profile_default/
ipython_config.py

# ---- Python environments ------------------------------------------------------
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ---- Spyder -------------------------------------------------------------------
.spyderproject
.spyproject

# ---- Rope ---------------------------------------------------------------------
.ropeproject

# ---- mkdocs -------------------------------------------------------------------
/site

# ---- mypy / Pyre / pytype -----------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ---- Cython debug -------------------------------------------------------------
cython_debug/

# ---- Ruff ---------------------------------------------------------------------
.ruff_cache/

# ---- PyPI config --------------------------------------------------------------
.pypirc

# ---- Marimo -------------------------------------------------------------------
marimo/_static/
marimo/_lsp/
__marimo__/


# ==============================================================================
# 8. Exceptions — keep this section LAST
# ==============================================================================

# Env templates hold variable names only, never values. `*.env*` above would
# otherwise ignore them.
!.env.example

# The Python `lib/` rule also matches JS/TS source folders such as src/lib/.
# Re-include any lib/ that sits under a src/ folder.
!**/src/**/lib/